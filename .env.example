# Postgres — same database as ledger-core / recon / revenue-rec.
# integrations mirrors recon's bank-* tables read-only and writes to
# them on sync (v0.1) or POSTs to recon's internal HTTP endpoint (v0.2).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledger_core?schema=public"

# Plaid credentials. Get free sandbox keys at https://dashboard.plaid.com/.
# Sandbox mode is free; production starts at ~$0.30/connected account.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "sandbox" | "development" | "production"
PLAID_ENV="sandbox"
# Products requested for new Items. "transactions" is the only one
# v0.1 uses; "auth" / "identity" / "balance" can be added later.
PLAID_PRODUCTS="transactions"
# Country codes the Link flow allows. ISO 3166-1 alpha-2.
PLAID_COUNTRY_CODES="US"

# Webhook URL Plaid POSTs events to. Required for production; in dev
# you can use ngrok or skip (v0.1 syncs are manually triggered).
# PLAID_WEBHOOK_URL="https://your-domain.com/api/webhooks/plaid"

# Cross-repo bridge tokens. v0.1 writes directly to recon's tables
# via shared DB; v0.2 will refactor to HTTP POST to recon's internal
# endpoint (same pattern as the ledger-core bridge).
# RECON_URL="http://localhost:3001"
# RECON_INTERNAL_TOKEN=""
