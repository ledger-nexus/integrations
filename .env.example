# For production deployment across all 5 repos in the portfolio, see:
#   ledger-core/docs/multi-repo-deploy.md
# RECON_INTERNAL_API_TOKEN below must match the value you set in recon's env.

# Postgres — same database as ledger-core / recon / revenue-rec.
# integrations mirrors recon's bank-* tables READ-ONLY (for the
# Connection.targetId lookup); writes go via HTTP POST to recon's
# /api/internal/bank-lines endpoint (no direct DB writes since v0.2).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledger_core?schema=public"

# Plaid credentials. Get free sandbox keys at https://dashboard.plaid.com/.
# Sandbox mode is free; production starts at ~$0.30/connected account.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
# "sandbox" | "development" | "production"
PLAID_ENV="sandbox"
# Products requested for new Items. "transactions" is the only one
# v0.1 uses; "auth" / "identity" / "balance" can be added later.
PLAID_PRODUCTS="transactions"
# Country codes the Link flow allows. ISO 3166-1 alpha-2.
PLAID_COUNTRY_CODES="US"

# Webhook URL Plaid POSTs events to. Required for production; in dev
# you can use ngrok or skip (v0.1 syncs are manually triggered).
# PLAID_WEBHOOK_URL="https://your-domain.com/api/plaid/webhook"

# Webhook authentication. Two complementary gates:
#
#   PLAID_WEBHOOK_JWT_REQUIRED — when "true" the route refuses any
#   request without a verifying Plaid-Verification JWT. Default: "true"
#   in production, "false" in dev. The verifier fetches Plaid's signing
#   key from /webhook_verification_key/get and caches by kid.
#
#   PLAID_WEBHOOK_SECRET — optional URL-token shared secret. When set,
#   Plaid must POST to /api/plaid/webhook?token=<this value>. The token
#   is verified alongside (not instead of) the JWT — both gates pass
#   for a request to be accepted. Holdover from the v1 deployment; can
#   be omitted once JWT-only is rolled out everywhere.
# PLAID_WEBHOOK_JWT_REQUIRED="true"
# PLAID_WEBHOOK_SECRET=""

# Cross-repo bridge to recon's bank-lines endpoint. The connector sync
# runner POSTs mapped Plaid transactions to /api/internal/bank-lines on
# recon (same shape as ledger-core's journal-entries endpoint). Both
# repos must share the same token value. Required for syncs; runs fail
# with UNAUTHORIZED if unset.
RECON_URL="http://localhost:3001"
RECON_INTERNAL_API_TOKEN=""
