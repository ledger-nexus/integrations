// integrations Prisma schema.
//
// Two halves, same pattern as recon / revenue-rec / xbrl-filer:
//
//   1. Shared-DB models integrations QUERIES but does NOT own:
//
//        - ledger-core-owned (Tenant, TenantMembership, User, LegalEntity,
//          Account, Currency). Mirror of the canonical definitions in
//          ledger-core's schema — column-for-column, relations trimmed to
//          the mirrored set. GENERATED from ledger-core main commit
//          9442667 (2026-07-16) — re-generate on upstream schema change,
//          never hand-drift.
//        - recon-owned (BankAccount, BankStatement, BankStatementLine).
//          Mirror of recon main's definitions, same rules. integrations
//          only READS these (Connection.targetId → BankAccount lookup);
//          writes go through recon's POST /api/internal/bank-lines HTTP
//          bridge (src/lib/recon-bridge.ts), never through Prisma.
//
//      integrations does NOT migrate any of these tables — their owners do.
//
//      The mirror is FK-CLOSED: every foreign key on a mirrored table
//      points at another mirrored table, so `npm run db:diff` produces
//      ZERO statements naming any mirrored table (shared-DB tables this
//      schema doesn't declare at all appear only as DROP noise — filtered
//      by the reviewed-diff protocol below, never applied). If the diff
//      ever shows a statement against a mirrored table, the mirror has
//      drifted — re-generate it from the owner's schema before doing
//      anything else.
//
//   2. integrations-OWNED models (Connection, SyncRun,
//      ImportStagingRecord). Schema changes to the shared DB are applied
//      via a REVIEWED `prisma migrate diff` script — NEVER `prisma db
//      push` or `migrate dev`. Because this schema declares only a subset
//      of the shared database, a blind push would execute the full diff,
//      including DROP/ALTER statements against every shared table this
//      file doesn't declare (or declares incorrectly). Protocol:
//
//        1. npm run db:diff                    # migrate diff → SQL script
//        2. Review: keep ONLY statements touching integrations-owned
//           tables (connection, sync_run, import_staging_record) and
//           integrations-owned enums (ConnectionStatus,
//           ConnectionTargetType, SyncStatus, SyncTriggerType,
//           StagingWriteStatus). Everything else is subset-of-shared-DB
//           noise and MUST NOT run.
//        3. npx prisma db execute --file <reviewed.sql>
//
// Shared DB: integrations connects with the same DATABASE_URL as
// ledger-core, recon, and revenue-rec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// integrations-OWNED models
// =========================================================================

// One row per third-party account connected. e.g., "Anna's Chase
// checking via Plaid" → one Connection row with the Plaid access_token,
// last sync cursor, etc.
//
// systemCode identifies the connector (plaid, stripe, gusto, ...).
// targetType identifies where synced data writes downstream — for v0.1
// only BANK_ACCOUNT is supported (target = a recon BankAccount).
model Connection {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  systemCode       String           // "plaid", "stripe", "gusto", "bill_com", ...
  displayName      String           // e.g. "Chase Operating ****1234"
  status           ConnectionStatus @default(ACTIVE)

  // The downstream object this connection feeds. v0.1: BANK_ACCOUNT
  // points at a recon BankAccount; v0.2 will add PARTY, GL_ACCOUNT,
  // VENDOR, etc. for other connectors.
  targetType       ConnectionTargetType
  targetId         String?          @db.Uuid

  // Connector-specific credentials. JSON blob — shape depends on
  // systemCode. For Plaid: { accessToken, itemId, institutionId,
  // institutionName, accountId }. Never logged; the engine treats it
  // as opaque.
  credentialsJson  Json

  // Last sync cursor (connector-defined string). For Plaid:
  // /transactions/sync returns a `next_cursor` we pass back on the
  // next call to get only new/updated transactions since.
  lastCursor       String?
  lastSyncedAt    DateTime?
  lastSyncStatus  SyncStatus?

  // Connection metadata. createdBy is the actor (User UUID or "system").
  createdBy        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deactivatedAt    DateTime?

  syncRuns         SyncRun[]

  @@unique([systemCode, targetId])
  @@index([status, systemCode])
  @@map("connection")
}

enum ConnectionStatus {
  ACTIVE        // syncs happen on schedule
  PAUSED        // connection exists but sync is off (auth needs refresh, etc.)
  REVOKED       // user disconnected; tokens may be invalid
  ERROR         // last sync failed; needs admin attention
}

enum ConnectionTargetType {
  BANK_ACCOUNT  // → recon BankAccount (Plaid for now)
  // v0.2+: PARTY, GL_ACCOUNT, VENDOR, EMPLOYEE
}

// One row per sync attempt. Append-only; never edited. Captures what
// happened on each run for the admin sync log + debugging.
model SyncRun {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String      @db.Uuid
  connection      Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  startedAt       DateTime    @default(now())
  completedAt     DateTime?
  status          SyncStatus  @default(RUNNING)

  // How the sync was triggered. MANUAL = user clicked "sync now";
  // SCHEDULED = cron job (v0.2); WEBHOOK = inbound webhook (v0.2).
  triggerType     SyncTriggerType

  // Cursor state. cursorBefore = what we passed to the connector;
  // cursorAfter = what the connector returned for next time.
  cursorBefore    String?
  cursorAfter     String?

  // Aggregate counts. recordsAdded includes new records the connector
  // reported; recordsModified = updates; recordsRemoved = soft-deletes
  // (the connector signaled the record is no longer valid).
  recordsAdded    Int         @default(0)
  recordsModified Int         @default(0)
  recordsRemoved  Int         @default(0)

  // For failures.
  errorCode       String?
  errorMessage    String?

  // Backref to the staging records this run ingested. Cleaned up
  // after successful downstream write.
  stagedRecords   ImportStagingRecord[]

  @@index([connectionId, startedAt])
  @@map("sync_run")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS  // some records failed downstream write but cursor advanced
  FAILURE          // sync failed; cursor NOT advanced
}

enum SyncTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
}

// Staging table for records pulled from a connector but not yet
// promoted to the downstream system (recon, ledger-core, etc.).
// Acts as a buffer for retries + auditing — if the downstream write
// fails, the staged row sticks around to retry.
//
// rawPayload is the original, verbatim record from the connector.
// Frozen, for re-mapping when the mapper logic evolves.
model ImportStagingRecord {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncRunId       String      @db.Uuid
  syncRun         SyncRun     @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  // The connector's external id for this record. Used for idempotency:
  // re-running a sync should NOT create duplicates.
  externalId      String

  // Raw record from the connector (frozen). For Plaid: the full
  // Transaction object as returned by /transactions/sync.
  rawPayload      Json

  // After mapping. Shape varies by connection.targetType.
  // For BANK_ACCOUNT: a BankStatementLine-shaped object.
  mappedPayload   Json?

  // Status of the downstream write.
  writeStatus     StagingWriteStatus @default(PENDING)
  writeError      String?
  writtenRecordId String?            @db.Uuid

  createdAt       DateTime    @default(now())
  writtenAt       DateTime?

  @@unique([syncRunId, externalId])
  @@index([writeStatus, createdAt])
  @@map("import_staging_record")
}

enum StagingWriteStatus {
  PENDING      // sync ingested it but downstream write hasn't happened
  WRITTEN      // promoted to downstream successfully
  FAILED       // downstream write errored; will be retried
  SKIPPED      // intentional skip (e.g., duplicate detected, filtered out)
}

// =========================================================================
// ledger-core mirror — DO NOT EDIT without re-syncing from ledger-core
// (generated from ledger-core main commit 9442667, 2026-07-16)
// =========================================================================

enum TenantRole {
  OWNER // cannot be removed; can delete the tenant
  ADMIN // full read+write+admin (period close, user lifecycle)
  MEMBER // read+write, no admin actions
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum TranslationCategory {
  CURRENT_RATE
  HISTORICAL
  WEIGHTED_AVG
  EXCLUDED
}

model Tenant {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String @unique // url-safe, e.g. "acme-co"
  name        String
  ownerUserId String @db.Uuid

  memberships TenantMembership[]

  // Backrefs from tenant-scoped domain models (mirrored subset only).
  legalEntities LegalEntity[]
  accounts      Account[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([ownerUserId])
  @@map("tenant")
}

model TenantMembership {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(MEMBER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  displayName   String
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  // Multi-tenancy: a User can belong to N Tenants via TenantMembership.
  // User itself is global (no tenantId) — login lookup is global by email.
  tenantMemberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_user")
}

model LegalEntity {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: code is unique PER tenant. Two tenants can both own
  // an entity coded "ACME" — collisions are isolated by tenantId.
  code           String
  name           String
  parentEntityId String?       @db.Uuid
  parent         LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  children       LegalEntity[] @relation("EntityHierarchy")

  // The currency this entity reports in. Each book may override for reporting.
  functionalCurrencyId String
  functionalCurrency   Currency @relation("EntityFunctionalCcy", fields: [functionalCurrencyId], references: [code])

  // NetSuite OneWorld: one subsidiary per group is the "elimination
  // subsidiary" — its only postings are the intercompany eliminations
  // the consolidation engine generates.
  isEliminationEntity Boolean @default(false)

  // Lineage — null for natively-created entities; populated on ERP import.
  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  accounts Account[]

  // Backref to the recon-owned mirror below.
  bankAccounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entity")
}

model Currency {
  // ISO 4217 code is the primary key — these are stable.
  code     String  @id // "USD", "EUR", "JPY"
  name     String
  decimals Int     @default(2) // 2 for USD, 0 for JPY, etc.
  symbol   String?

  entitiesFunctional LegalEntity[] @relation("EntityFunctionalCcy")

  @@map("currency")
}

model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entityId null = shared across all entities (consolidated chart).
  entityId String?      @db.Uuid
  entity   LegalEntity? @relation(fields: [entityId], references: [id])

  // Human-readable code (e.g. "1000" for Cash). NOT a source-system primary key.
  code             String
  name             String
  type             AccountType
  normalBalance    NormalBalance
  subtype          String? // e.g. "CASH", "AR_TRADE", "INVENTORY_RAW"
  isContra         Boolean       @default(false)
  isControlAccount Boolean       @default(false) // true for AR/AP control accounts
  isBank           Boolean       @default(false)

  // ASC 830 / IAS 21: monetary accounts are re-measured at period-end CLOSE
  // rate; non-monetary accounts stay at historical rate.
  isMonetary Boolean @default(false)

  // FX Phase 4 — ASC 830 translation method for CONSOLIDATION. Nullable so
  // existing single-currency installations don't need a backfill.
  translationCategory TranslationCategory?

  parentAccountId String?   @db.Uuid
  parent          Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[] @relation("AccountHierarchy")

  // Books this account applies to. Empty = applies to all books.
  bookScope String[] @default([])

  active Boolean @default(true)

  // BlackLine arc Phase 1: per-account override of the tenant default.
  requiresReconReview Boolean?
  reconTolerance      Decimal? @db.Decimal(20, 4)

  // Backref to the recon-owned mirror below.
  bankAccounts BankAccount[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([type])
  @@index([tenantId])
  // Created by ledger-core's raw SQL (prisma/migrations/0001_constraints);
  // declared here so db:diff stays clean (zero ledger-core statements).
  @@index([extensions(ops: JsonbOps)], map: "account_extensions_gin", type: Gin)
  @@map("account")
}

// =========================================================================
// recon mirror — DO NOT EDIT without re-syncing from recon
// (generated from recon main, 2026-07-16)
// =========================================================================
//
// integrations only READS these tables (BankAccount lookup at connect /
// sync time, BankStatement listing on the connection detail page). All
// writes go through recon's POST /api/internal/bank-lines HTTP bridge —
// see src/lib/recon-bridge.ts and docs/ARCHITECTURE.md.

enum BankLineStatus {
  UNMATCHED  // no match proposed yet
  PROPOSED   // a match has been suggested (deterministic or AI)
  MATCHED    // human approved the match
  IGNORED    // human marked as not requiring reconciliation
  ADJUSTMENT // human posted an adjustment JE to resolve the line
}

model BankAccount {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  code               String  @unique // human-readable, e.g. "CHASE-OPERATING"
  displayName        String
  bankName           String?
  accountNumberLast4 String?
  currencyId         String  @default("USD")
  isActive           Boolean @default(true)

  statements BankStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bank_account")
}

model BankStatement {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId String      @db.Uuid
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  // Source metadata
  filename   String
  uploadedAt DateTime @default(now())
  uploadedBy String?
  format     String // e.g. "PLAID_SYNC_V1" for integrations-imported statements
  rawPayload String // verbatim source content for audit / re-parse

  // Statement period
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  openingBalance Decimal  @db.Decimal(18, 4)
  closingBalance Decimal  @db.Decimal(18, 4)

  lines BankStatementLine[]

  // Aggregate status for the UI
  totalLines   Int @default(0)
  matchedLines Int @default(0)
  pendingLines Int @default(0)

  @@index([bankAccountId, periodEnd])
  @@map("bank_statement")
}

model BankStatementLine {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId String        @db.Uuid
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  lineNo          Int // 1-based order within the statement
  transactionDate DateTime  @db.Date
  postedDate      DateTime? @db.Date
  description     String
  // Signed: positive = deposit / inflow, negative = withdrawal / outflow.
  amount         Decimal  @db.Decimal(18, 4)
  runningBalance Decimal? @db.Decimal(18, 4)
  externalRef    String? // bank's own transaction id when available

  status BankLineStatus @default(UNMATCHED)

  // Audit trail for IGNORED status (recon v1.0). Populated by recon's
  // ignoreLineAction; preserved across un-ignore.
  ignoredAt    DateTime?
  ignoredBy    String?
  ignoreReason String?

  @@unique([statementId, lineNo])
  @@index([statementId, status])
  @@index([transactionDate])
  @@map("bank_statement_line")
}
